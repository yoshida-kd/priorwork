# Copy this file to .env and fill in your keys:  cp .env.example .env
# .env.example is committed to Git (no secrets here). .env is in .gitignore — never commit it.

# Semantic Scholar API key (optional, recommended)
# Without a key, requests share a public pool and hit HTTP 429 often.
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex (optional): used to verify DOIs/ISSNs of Semantic Scholar results.
# Works without a key, but with a daily usage cap.
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# Zotero Web API (optional, read-only). Create a key at https://www.zotero.org/settings/keys
# with ONLY "Allow library access" checked. The user ID is shown on the same page.
ZOTERO_API_KEY=
ZOTERO_USER_ID=

# WebDAV file sync (e.g. Nextcloud). URL of the folder that contains Zotero's <key>.zip files,
# i.e. the URL set in Zotero + "zotero/". A read-only share with an app password is recommended.
ZOTERO_WEBDAV_URL=
ZOTERO_WEBDAV_USER=
ZOTERO_WEBDAV_PASSWORD=

# Local Zotero data directory (default: ~/Zotero), used only if Zotero runs on this machine.
# ZOTERO_DATA_DIR=

# Path to the SSCI journal list CSV from Clarivate Master Journal List
# (default: a CSV in .priorwork/data/ whose filename contains "SSCI")
# SSCI_JOURNAL_LIST=

# Retries on HTTP 429/5xx (default: 5)
# PRIORWORK_MAX_RETRIES=
# Cache lifetime in days (default: 7). Set PRIORWORK_NO_CACHE=1 to disable.
# PRIORWORK_CACHE_TTL_DAYS=
